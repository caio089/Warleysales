{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "../../src/*"
      ]
    },
    "allowJs": true,
    "incremental": true,
    "resolveJsonModule": true
  },
  "include": [
    "next-env.d.ts",
    "app/auth/callback/route.ts",
    "../../src/app/auth/callback/route.ts",
    "../../src/server/supabase/session-client.ts",
    "../../artifacts/callback-next/types/**/*.ts",
    "../../artifacts/callback-next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
