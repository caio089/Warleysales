# Copie para .env.local. NUNCA commitar valores reais.
NEXT_PUBLIC_SUPABASE_URL=
# Chave publicável (sb_publishable_...). Fallback legado aceito: NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Somente servidor (jobs/administração). Jamais expor ao navegador.
# Obtenha em Supabase > Settings > API > service_role e cole em .env.local e na Vercel.
SUPABASE_SERVICE_ROLE_KEY=
# Segredo para proteger endpoints de cron (>= 16 caracteres; ex.: openssl rand -hex 32)
CRON_SECRET=
APP_TIMEZONE=America/Fortaleza
# URL pública do site (links de convite e recuperação por e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
